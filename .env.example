APP_ENV=development

LLM_PROVIDER=mistral
DEFAULT_MODEL=mistral-small-latest
MISTRAL_API_KEY=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=school-chatbot-prod-v2
PINECONE_NAMESPACE=school_chatbot_v2

MEM0_API_KEY=

DEFAULT_USER_ID=local-development-user

EMBEDDING_MODEL_NAME=BAAI/bge-m3
INDEX_VERSION=v2
CHUNKING_VERSION=v1

RAG_SEARCH_TYPE=mmr
RAG_TOP_K=6
RAG_FETCH_K=20
RAG_NEIGHBOR_PAGE_WINDOW=1
RAG_NEIGHBOR_CHUNKS_PER_PAGE=5
RAG_MIN_RELEVANCE_SCORE=0

RAG_MAX_INITIAL_DOCS=12
RAG_MAX_CONTEXT_DOCS=20
RAG_MAX_CONTEXT_CHARS=30000

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

MEM0_TOP_K=5
MAX_QUESTION_LENGTH=2000
MAX_USER_ID_LENGTH=128
MAX_CHAT_HISTORY_TURNS=12

REDIS_URL=redis://localhost:6379
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.10

LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501



REDIS_URL=redis://localhost:6379
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.10



